# Isolated, explicitly gated, three-wake model-selected local telemetry test.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN pip install --no-cache-dir "asyncpg>=0.29,<1" "httpx>=0.27,<1" \
    && useradd --create-home --uid 10001 dragonzpyder
COPY . /app
RUN chown -R dragonzpyder:dragonzpyder /app
USER dragonzpyder
CMD ["python", "-m", "agent_platform.horizon_agent"]
