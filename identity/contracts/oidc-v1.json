  ],
  "client": {
    "client_id": "operly-web",
    "redirect_uris": [
      "https://operly.dragonzpyder.xyz/api/identities/dragonzpyder/callback"
    ],
    "token_endpoint_auth_method": "client_secret_basic"
  },
  "account_mapping": {
    "key": [
      "issuer",
      "sub"
    ],
    "never_link_by_email": true
  },
  "status": "planned_not_active"
