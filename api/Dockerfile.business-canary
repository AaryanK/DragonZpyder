# Isolated, credential-free recurring synthetic business contract check.
# This worker does not execute actual Operly business requests.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN pip install --no-cache-dir "httpx>=0.27,<1" "langchain-core>=0.3,<2" "pytest>=8,<10" \
    && useradd --create-home --uid 10001 dragonzpyder
COPY . /app
RUN chown -R dragonzpyder:dragonzpyder /app
USER dragonzpyder
CMD ["python", "-m", "agent_platform.synthetic_business_cron"]
