{
  "version": 1,
  "issuer": "https://auth.dragonzpyder.xyz",
  "authorization_endpoint": "https://auth.dragonzpyder.xyz/oauth/authorize",
  "token_endpoint": "https://auth.dragonzpyder.xyz/oauth/token",
